# Maintainer: the-sleepless <157875041+the-sleepless@users.noreply.github.com>
pkgname=sleep-aur
pkgver=3.1.7
pkgrel=1
pkgdesc="A minimalist, auditable AUR helper for Arch Linux"
arch=('any')
url="https://github.com/the-sleepless/sleep-aur"
license=('MIT')
depends=('bash' 'git' 'jq' 'curl' 'pacman' 'base-devel')
conflicts=('sleep-aur-bin' 'sleep-aur-git')
options=('!strip' '!debug')
source=(
    "${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/sleep-aur.tar.gz"
    "LICENSE::https://raw.githubusercontent.com/the-sleepless/sleep-aur/v${pkgver}/LICENSE"
)
sha256sums=(
    '83ba13d19091ee58a8b12d102590b7205c460bc24f8fc80ffbef2b512e43aef0'
    'be7adf6feee2fb243a932c0ed1415eb319a786c8e4bd27df044d4c75ff5723af'
)

package() {
    install -d "$pkgdir/usr/lib/sleep-aur"
    install -m755 "$srcdir/sleep-aur" "$pkgdir/usr/lib/sleep-aur/sleep-aur"
    cp -a "$srcdir/lib" "$pkgdir/usr/lib/sleep-aur/lib"
    install -m644 "$srcdir/VERSION" "$pkgdir/usr/lib/sleep-aur/VERSION"

    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/sleep-aur/sleep-aur "$pkgdir/usr/bin/sleep-aur"

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
